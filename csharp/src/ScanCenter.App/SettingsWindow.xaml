<Window x:Class="ScanCenter.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="640" Height="560" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,10"
                   Text="These settings apply to every scan button." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save settings" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="Save_Click" Padding="16,6" />
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" Padding="16,6" />
        </StackPanel>
        <TabControl x:Name="Tabs">
            <TabItem Header="Connection">
                <StackPanel Margin="12">
                    <TextBlock Text="saned server" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <DockPanel>
                        <TextBox x:Name="PortBox" DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" ToolTip="Port (normally 6566)" />
                        <TextBlock DockPanel.Dock="Right" Text="Port" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBox x:Name="HostBox" ToolTip="Name or IP address of the computer running saned, for example 192.168.1.10" />
                    </DockPanel>
                    <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UserBox" ToolTip="Sent to saned; leave empty unless your server asks for one" />
                    <TextBlock Text="Scanner" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button x:Name="FindButton" DockPanel.Dock="Right" Content="Find scanners" Margin="8,0,0,0" Click="Find_Click" />
                        <ComboBox x:Name="DeviceBox" IsEditable="True" />
                    </DockPanel>
                    <CheckBox x:Name="FindOnStartBox" Content="Look for scanners every time the app starts" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="TestButton" Content="Test connection" Click="Test_Click" />
                        <TextBlock x:Name="TestResult" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Preview">
                <StackPanel Margin="12">
                    <TextBlock Text="Preview resolution" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <ComboBox x:Name="PreviewResBox" Width="200" HorizontalAlignment="Left" />
                    <CheckBox x:Name="PreviewMinBox" Content="Always use the scanner's lowest resolution (fastest)" />
                    <CheckBox x:Name="PreviewStartBox" Content="Run a preview as soon as the app opens" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Saving">
                <StackPanel Margin="12">
                    <TextBlock Text="Default folder for scans" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseRoot_Click" />
                        <TextBox x:Name="RootBox" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                               Text="Used for buttons you reset to their defaults." />
                    <TextBlock Text="JPEG quality" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <TextBlock x:Name="JpegValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right" VerticalAlignment="Center" />
                        <Slider x:Name="JpegSlider" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" />
                    </DockPanel>
                    <TextBlock Text="Text recognition (OCR) language" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="OcrBox" />
                    <TextBlock x:Name="OcrNote" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                    <CheckBox x:Name="SoundBox" Content="Play a sound when a file is saved" Margin="0,12,0,0" />
                    <CheckBox x:Name="NotifyBox" Content="Show a notification when a file is saved" />
                </StackPanel>
            </TabItem>
            <TabItem Header="General">
                <StackPanel Margin="12">
                    <CheckBox x:Name="StartupBox" Content="Start with Windows and wait in the notification area" Margin="0" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="26,2,0,0"
                               Text="While this is on, closing the window keeps the app running next to the clock. Use Quit in its menu to stop it." />
                    <CheckBox x:Name="TopBox" Content="Keep the window on top of other windows" Margin="0,12,0,0" />
                    <CheckBox x:Name="EscBox" Content="Ignore the Esc key (otherwise Esc cancels a running scan)" />
                    <CheckBox x:Name="HideBox" Content="Hide settings the scanner doesn't support in the chosen scan type" />
                    <CheckBox x:Name="ShareBox" Content="Share connection settings with SaneTwain (sanetwain.ini)" />
                    <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ThemeBox" Width="200" HorizontalAlignment="Left" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Printer">
                <StackPanel Margin="12">
                    <TextBlock Text="Printer" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <ComboBox x:Name="PrinterBox" />
                    <CheckBox x:Name="PrintOptionsBox" Content="Show printer options before printing" Margin="0,12,0,0" />
                    <CheckBox x:Name="PrintWaitBox" Content="Wait until all pages are scanned, then print them together" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"
                               Text="Used by the Copy button and by any button set to &quot;Print it&quot;. Without waiting, each page prints as soon as it's scanned. Pages print at their real size." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
