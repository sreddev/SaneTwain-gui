<Window x:Class="ScanCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScanCenter.App"
        Title="SaneTwain Scan Center" Width="1280" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <!-- Immersive title bar: the app header is the title bar; Windows draws no caption of its own. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.ScanCommand}" />
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.PreviewCommand}" />
        <KeyBinding Key="Escape" Command="{x:Static local:MainWindow.EscapeCommand}" />
    </Window.InputBindings>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="420" />
            <RowDefinition Height="6" />
            <RowDefinition Height="150" MinHeight="90" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header = title bar -->
        <Border Grid.Row="0" Height="48" Padding="14,0,0,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaxButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximize" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" AutomationProperties.Name="Close" />
                </StackPanel>
                <Button x:Name="AppSettingsButton" DockPanel.Dock="Right" Click="AppSettings_Click" Padding="12,5" Margin="0,0,10,0" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Connection, printer, theme and other options for the whole app">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/ScanCenter.ico" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="SaneTwain Scan Center" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Margin="16,0,12,0" Padding="10,3" CornerRadius="11" VerticalAlignment="Center" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DeviceDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="DeviceText" FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 2. Settings for the chosen scan button (left sidebar, full height) -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,14,16,16">
                        <!-- Title: icon, name (editable for custom buttons) -->
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,0,0,12" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <Border x:Name="SideIconBox" DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8" Margin="0,0,10,0">
                                        <ContentPresenter x:Name="SideIcon" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SETTINGS FOR" Style="{StaticResource Eyebrow}" />
                                        <TextBlock x:Name="SideTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel x:Name="CustomPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Name" Style="{StaticResource RowLabel}" />
                                        <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="1" Text="Icon" Style="{StaticResource RowLabel}" />
                                        <ComboBox x:Name="IconBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <Button x:Name="DeleteProfileButton" Content="Delete this button" Margin="0,8,0,0" HorizontalAlignment="Left" Click="DeleteProfile_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Destination -->
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <Border Style="{StaticResource GroupHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="Destination" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GroupRow}">
                                    <StackPanel>
                                        <TextBlock Text="Folder" Style="{StaticResource RowLabel}" Margin="0,0,0,4" />
                                        <DockPanel>
                                            <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Margin="6,0,0,0" Click="OpenFolder_Click" ToolTip="Open this folder">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" />
                                            </Button>
                                            <Button x:Name="ChangeFolderButton" DockPanel.Dock="Right" Margin="6,0,0,0" Content="Change…" Click="ChangeFolder_Click" />
                                            <TextBox x:Name="FolderBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalContentAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock x:Name="MissingFolder" Style="{StaticResource Caution}" Margin="0,4,0,0" Visibility="Collapsed" Text="This folder doesn't exist yet." />
                                        <CheckBox x:Name="CreateFolderBox" Content="Create the folder if it's missing" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GroupRow}">
                                    <StackPanel>
                                        <TextBlock Text="File name" Style="{StaticResource RowLabel}" Margin="0,0,0,4" />
                                        <TextBox x:Name="PatternBox" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock Text="Insert:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Button Content="{}{profile}" Tag="{}{profile}" Click="Token_Click" Padding="6,2" Margin="0,0,4,4" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                            <Button Content="{}{date}" Tag="{}{date}" Click="Token_Click" Padding="6,2" Margin="0,0,4,4" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                            <Button Content="{}{time}" Tag="{}{time}" Click="Token_Click" Padding="6,2" Margin="0,0,4,4" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                            <Button Content="{}{n}" Tag="{}{n}" Click="Token_Click" Padding="6,2" Margin="0,0,4,4" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                        </WrapPanel>
                                        <TextBlock x:Name="NamePreview" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GroupRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="File type" Style="{StaticResource RowLabel}" />
                                        <ComboBox x:Name="TypeBox" Grid.Column="1" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Scan quality -->
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <Border Style="{StaticResource GroupHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9E9;" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="Scan quality" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GroupRow}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Resolution" Style="{StaticResource RowLabel}" />
                                        <ComboBox x:Name="ResBox" Grid.Column="1" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource GroupRow}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Document size" Style="{StaticResource RowLabel}" />
                                        <ComboBox x:Name="SizeBox" Grid.Column="1" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Border>
                                <Border x:Name="SourceRow" Style="{StaticResource GroupRow}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Source" Style="{StaticResource RowLabel}" />
                                        <ComboBox x:Name="SourceBox" Grid.Column="1" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource GroupRow}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Scan type" Style="{StaticResource RowLabel}" />
                                        <ComboBox x:Name="ModeBox" Grid.Column="1" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Border>
                                <Border x:Name="BrightnessRow" Style="{StaticResource GroupRow}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Brightness" Style="{StaticResource RowLabel}" />
                                        <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="-50" Maximum="50" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BrightnessValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border x:Name="ContrastRow" Style="{StaticResource GroupRow}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Contrast" Style="{StaticResource RowLabel}" />
                                        <Slider x:Name="ContrastSlider" Grid.Column="1" Minimum="-50" Maximum="50" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ContrastValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource GroupRowLast}">
                                    <StackPanel>
                                        <TextBlock x:Name="AdjustNote" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock x:Name="Estimate" Style="{StaticResource Muted}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- When the scan ends -->
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <Border Style="{StaticResource GroupHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C1;" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="When the scan ends" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GroupRow}">
                                    <StackPanel>
                                        <CheckBox x:Name="WriteToDiskBox" Content="Write file to disk"
                                                  ToolTip="On: the file is saved in the folder as soon as the scan ends. Off: the pages wait until you click Save file." />
                                        <TextBlock x:Name="WriteToDiskNote" FontSize="12" TextWrapping="Wrap" Margin="28,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GroupRow}">
                                    <CheckBox x:Name="MultiBox" Content="Ask for another page after each scan" />
                                </Border>
                                <Border Style="{StaticResource GroupRowLast}">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Then" Style="{StaticResource RowLabel}" />
                                            <ComboBox x:Name="AfterBox" Grid.Column="1" HorizontalAlignment="Stretch" />
                                        </Grid>
                                        <CheckBox x:Name="SaveFileBox" Content="Also save a file" Margin="104,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Button x:Name="ResetButton" Content="Reset this button to defaults" HorizontalAlignment="Left" Click="Reset_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right column -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 3. Scan buttons -->
                <Border Grid.Row="0" Padding="16,10,8,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="SCAN BUTTONS" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                            <TextBlock Text="Click to choose · ▶ scans right away" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <WrapPanel x:Name="TileList" />
                    </StackPanel>
                </Border>

                <!-- 4. Toolbar -->
                <Border Grid.Row="1" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <DockPanel>
                        <Button x:Name="ScanButton" Style="{DynamicResource AccentButtonStyle}" Padding="20,8" Click="Scan_Click" FontWeight="SemiBold" Content="Scan" />
                        <Button x:Name="PreviewButton" Margin="8,0,0,0" Padding="12,8" Click="Preview_Click" ToolTip="Quick low-resolution pass (F5). Nothing is saved.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE890;" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Preview" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelButton" Margin="8,0,0,0" Padding="14,8" Click="Cancel_Click" Content="Cancel" Visibility="Collapsed" />
                        <Rectangle Width="1" Margin="12,4" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock x:Name="Hint" VerticalAlignment="Center" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="Place the document face down, top edge against the corner arrow." />
                    </DockPanel>
                </Border>

                <!-- 5. Scanner glass card -->
                <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="16,10,16,8" Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="GlassMeta" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="SCANNER GLASS" Style="{StaticResource Eyebrow}" />
                        </DockPanel>
                        <local:PlatenView x:Name="Platen" Grid.Row="1" Margin="0,4,0,8" />
                        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,8,0,0">
                            <DockPanel Height="72">
                                <TextBlock DockPanel.Dock="Left" Text="PAGES" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Width="56" />
                                <Grid>
                                    <TextBlock x:Name="TrayEmpty" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                               Text="Scanned pages collect here until the file is saved." />
                                    <ListBox x:Name="TrayList" BorderThickness="0" Background="Transparent" Visibility="Collapsed"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2">
                                                    <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="White">
                                                        <Image Source="{Binding Thumb}" Width="38" Height="50" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" Style="{StaticResource Muted}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Remove this page" Click="RemovePage_Click" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                    </ListBox>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Next page / error prompts -->
                <StackPanel Grid.Row="3" Margin="16,0,16,8">
                    <Border x:Name="MoreBar" Style="{StaticResource Panel}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="MoreTitle" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock x:Name="MoreText" Style="{StaticResource Muted}" Margin="0,4,0,10"
                                       Text="Place the next page on the glass and scan it, or finish to save the file now." />
                            <DockPanel>
                                <Button x:Name="DiscardButton" DockPanel.Dock="Right" Content="Discard pages" Click="Discard_Click" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="MoreYes" Style="{DynamicResource AccentButtonStyle}" Content="Scan next page" Click="NextPage_Click" Padding="14,6" />
                                    <Button x:Name="MoreNo" Content="Finish and save" Click="Finish_Click" Margin="8,0,0,0" Padding="14,6" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ErrorBar" Style="{StaticResource Panel}" BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ErrorTitle" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBox x:Name="ErrorBody" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,4,0,10" Padding="0" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ErrorAction" Style="{DynamicResource AccentButtonStyle}" Content="Retry" Click="ErrorAction_Click" Padding="14,6" />
                                <Button Content="Dismiss" Click="ErrorDismiss_Click" Margin="8,0,0,0" Padding="14,6" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 6. Results -->
        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="6"
                      Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <TabControl Grid.Row="3" Margin="12,0,12,6">
            <TabItem Header="Saved files">
                <ListView x:Name="SavedList" MouseDoubleClick="SavedList_DoubleClick" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="300" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Folder" Width="360" DisplayMemberBinding="{Binding Folder}" />
                            <GridViewColumn Header="Pages" Width="70" DisplayMemberBinding="{Binding Pages}" />
                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Size}" />
                            <GridViewColumn Header="Saved" Width="90" DisplayMemberBinding="{Binding Time}" />
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Click="SavedOpen_Click" />
                            <MenuItem Header="Show in folder" Click="SavedShow_Click" />
                            <MenuItem Header="Copy path" Click="SavedCopy_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </TabItem>
            <TabItem Header="Activity">
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
            </TabItem>
        </TabControl>

        <!-- 7. Status bar -->
        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="14,6"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <TextBlock x:Name="StatusMeta" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                <ProgressBar x:Name="StatusProgress" DockPanel.Dock="Right" Width="180" Height="4" Maximum="1" VerticalAlignment="Center" />
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
