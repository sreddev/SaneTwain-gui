<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ScanCenter</AssemblyName>
    <RootNamespace>ScanCenter.App</RootNamespace>
    <ApplicationIcon>Assets\ScanCenter.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>SaneTwain Scan Center</Product>
    <Version>1.0.0</Version>
    <!-- WPF Fluent theme (ThemeMode) is marked experimental in .NET 9/10 -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\ScanCenter.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScanCenter.Core\ScanCenter.Core.csproj" />
  </ItemGroup>
</Project>
