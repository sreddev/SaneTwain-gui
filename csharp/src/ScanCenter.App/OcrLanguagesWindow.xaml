<Window x:Class="ScanCenter.App.OcrLanguagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR languages" Width="560" Height="600" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Text recognition languages" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"
                       Text="Searchable PDFs use the text recognition built into Windows. Tick the languages you scan in and click Install. Windows asks for administrator permission once, then downloads them from Windows Update. Untick a language to remove it." />
            <TextBox x:Name="FilterBox" Margin="0,0,0,8" ToolTip="Type part of a language name to find it" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <Border x:Name="BusyPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" />
                    <TextBlock x:Name="BusyText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
            <DockPanel Margin="0,12,0,0">
                <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ApplyButton" Content="Install" Style="{DynamicResource AccentButtonStyle}" IsDefault="True"
                            Click="Apply_Click" Padding="16,6" IsEnabled="False" />
                    <Button x:Name="CloseButton" Content="Close" IsCancel="True" Margin="8,0,0,0" Padding="16,6" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Border BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,6">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
